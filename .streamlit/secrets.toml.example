# Copy this to secrets.toml and fill in your Turso credentials.
# For local development, you can leave this file absent and it will use local SQLite.
# For Streamlit Cloud, paste these values in the app's Secrets settings.

TURSO_URL = "libsql://your-db-name-your-username.turso.io"
TURSO_AUTH_TOKEN = "your-auth-token-here"
